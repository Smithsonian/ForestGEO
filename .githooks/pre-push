#!/bin/sh

# The Git LFS dispatch that used to head this file has been removed. It aborted
# the push with exit 2 whenever git-lfs was absent from PATH — on EVERY branch,
# because the check ran before the branch test — and this repository uses no LFS
# (no .gitattributes, no `git lfs ls-files` entries). It also consumed the stdin
# that the loop below needs, so the test gate could never have run while LFS was
# installed either. If LFS is adopted later, re-add it guarded by
# `command -v git-lfs` and feed the loop from a saved copy of stdin.

# Read stdin for branch information
while read local_ref local_sha remote_ref remote_sha
do
  # Extract the remote branch name (remove refs/heads/ prefix)
  remote_branch=$(echo "$remote_ref" | sed 's/refs\/heads\///')

  # Check if pushing to main or forestgeo-app-development branches
  if [ "$remote_branch" = "main" ] || [ "$remote_branch" = "forestgeo-app-development" ]; then
    echo ""
    echo "🔍 Pushing to protected branch: $remote_branch"
    echo "🧪 Running tests before push..."
    echo ""

    # Change to frontend directory and run tests
    cd frontend || exit 1

    # Run the same CI-safe unit suite that gates protected-branch deployments
    if ! npm run test:unit:ci; then
      echo ""
      echo "❌ Tests failed! Push aborted."
      echo "Please fix the failing tests before pushing to $remote_branch"
      echo ""
      exit 1
    fi

    echo ""
    echo "✅ All tests passed! Proceeding with push..."
    echo ""
  fi
done

exit 0
