# superpowers scratch (plans, specs, mockups) — ignored everywhere, no exceptions.
# Deliberately no re-include rules: git cannot descend into an excluded directory,
# so any carve-out here would need the parent un-ignored, which is what let scratch
# docs reach the repo before. A note worth keeping goes in docs/notes/ instead.
# frontend/.husky/pre-commit rejects these paths even when staged with `git add -f`.
# No trailing slash: that form matches directories ONLY, and each checkout holds a
# SYMLINK named `superpowers` pointing at the shared local store, which git treats
# as a blob. With the slash the link itself showed up as untracked.
superpowers
.superpowers

# personal weekly work notes — synced to Obsidian, not source-controlled
weekly-notes/

# agent/tool scratch dirs & generated artifacts
.claude/
.codex/
.worktrees/
